# syntax=docker/dockerfile:1
# PdfCraft Web: a precompiled static WebAssembly site packaged by GitHub Actions.
# Build context: docker-build/ (generated by .github/workflows/publish-image.yml).
# Rust, Trunk and the OCR models are handled on the CI runner, not in this runtime image.
ARG NGINX_VERSION=1.28-alpine
FROM nginx:${NGINX_VERSION}

ARG PDFCRAFT_COMMIT=unknown
ARG CRAFT_FONTS_COMMIT=unknown
ARG PDFCRAFT_VERSION=unknown

LABEL org.opencontainers.image.title="PdfCraft Web" \
      org.opencontainers.image.description="Community-maintained self-hosted browser build of PdfCraft" \
      org.opencontainers.image.source="https://github.com/MikaPST/pdfcraft-web" \
      org.opencontainers.image.url="https://github.com/MikaPST/pdfcraft-web" \
      org.opencontainers.image.version="${PDFCRAFT_VERSION}" \
      org.opencontainers.image.revision="${PDFCRAFT_COMMIT}" \
      io.mikapst.pdfcraft.craft-fonts-revision="${CRAFT_FONTS_COMMIT}"

# Replace the complete NGINX configuration: it listens on an unprivileged port,
# writes temporary files under /tmp and serves only static content.
COPY nginx.conf /etc/nginx/nginx.conf
COPY --chown=nginx:nginx dist/ /usr/share/nginx/html/

USER nginx
EXPOSE 8080

# Disable the base image entrypoint: its startup helpers may try writing to /etc/nginx.
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
